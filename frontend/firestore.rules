rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCrmAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/_crm_admin_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/_crm_admin_access/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/_crm_admin_access/$(request.auth.uid)).data.approvedUntil > request.time;
    }

    function isBackendService() {
      return request.auth != null
        && request.auth.uid == 'vagafogo-server-backend'
        && request.auth.token.serverBackend == true;
    }

    function isPrivileged() {
      return isBackendService() || isCrmAdmin();
    }

    // Roles, membership and commissions are authorized exclusively by the API.
    // Even the browser administrator cannot grant access by writing these records.
    match /_crm_admin_access/{document=**} {
      allow read, write: if false;
    }
    match /affiliate_memberships/{document=**} {
      allow read, write: if false;
    }
    match /affiliate_agencies/{document=**} {
      allow read, write: if false;
    }
    match /affiliate_partners/{document=**} {
      allow read, write: if false;
    }
    match /affiliate_links/{document=**} {
      allow read, write: if false;
    }
    match /_affiliate_emails/{document=**} {
      allow read, write: if false;
    }
    match /_affiliate_link_tokens/{document=**} {
      allow read, write: if false;
    }
    match /_affiliate_contexts/{document=**} {
      allow read, write: if false;
    }
    match /_affiliate_session_contexts/{document=**} {
      allow read, write: if false;
    }
    match /_affiliate_activations/{document=**} {
      allow read, write: if false;
    }
    match /_affiliate_payment_evidence/{document=**} {
      allow read, write: if false;
    }

    // Dados da feature de formularios sao exclusivamente server-side.
    // O Firebase Admin SDK usado pelo backend ignora estas regras.
    match /formularios/{document=**} {
      allow read, write: if false;
    }

    match /_formularios_public_ids/{document=**} {
      allow read, write: if false;
    }

    match /_formularios_admin_idempotency/{document=**} {
      allow read, write: if false;
    }

    // Chaves de pagamento sao controladas exclusivamente pelo backend.
    match /_payment_idempotency/{document=**} {
      allow read, write: if false;
    }

    // Reserva defensiva caso respostas sejam migradas para uma colecao raiz.
    match /respostas/{document=**} {
      allow read, write: if false;
    }

    // Colecoes publicas consumidas diretamente pelo site atual.
    match /pacotes/{documentId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged();
    }

    match /tipos_clientes/{documentId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged();
    }

    match /combos/{documentId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged();
    }

    match /disponibilidade/{documentId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged();
    }

    // Public availability and reservation lookup are exposed as limited API DTOs.
    match /reservas/{documentId} {
      allow read, write: if isPrivileged();
    }

    // Campanhas e auditoria sao escritas somente pelo backend autenticado.
    match /crm_campanhas/{campaignId} {
      allow read: if isPrivileged();
      allow write: if false;

      match /destinatarios/{recipientId} {
        allow read: if isPrivileged();
        allow write: if false;
      }
    }

    // Resultado dos disparos unitarios de homologacao para o numero interno.
    match /crm_campanhas_testes/{testId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    // Jornadas do checkout sao gravadas somente pelo backend. O painel
    // autenticado recebe leitura para funil, origem e recuperacao consentida.
    match /crm_jornadas/{journeyId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    // Resumo comercial produzido pelo Agente. A conversa bruta nao e salva.
    match /crm_leads_agente/{leadId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    match /crm_whatsapp_contatos/{documentId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    match /crm_whatsapp_mensagens/{documentId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    match /whatsapp_notificacoes_internas/{documentId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    // The public website only needs the site document. Email/WhatsApp stay private.
    match /configuracoes/{configId} {
      allow get: if configId == 'site' || isPrivileged();
      allow list: if isPrivileged();
      allow create, update, delete: if isPrivileged();
    }

    // Colecoes usadas apenas dentro do painel/diagnostico legado.
    match /mesas/{documentId} {
      allow read, create, update, delete: if isPrivileged();
    }

    match /teste_conexao/{documentId} {
      allow read, create, update, delete: if isPrivileged();
    }
  }
}
